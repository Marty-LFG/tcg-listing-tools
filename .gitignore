node_modules
.env
.env.local
dist
data/tracker.db
data/tracker.db-wal
data/tracker.db-shm
data/repricer.db
data/repricer.db-wal
data/repricer.db-shm
data/postsale.db
data/postsale.db-wal
data/postsale.db-shm
reports/

# eBay channel secrets + artifacts (bulk listing tool) — NEVER commit.
# data/ebay-oauth.json holds the Sell-API refresh token (a long-lived credential);
# data/ebay-categories.json is a pinned live-Taxonomy cache; data/exports/ holds
# generated listing CSVs. data/samples/ (test fixtures) stays tracked.
data/ebay-oauth.json
data/ebay-*.json
!data/ebay-listing.config.example.json
# The notification listener's seed. Without this negation the blanket data/ebay-*.json above swallows
# it, ensureConfigSeeded() finds nothing to copy on a fresh clone, and the listener silently never
# arms — with no error, because a missing config legitimately means "disabled".
!data/ebay-notify.config.example.json
data/exports/

# Generated on-disk caches (not source): PriceCharting scrape results + proxied card images.
data/pc-cache/
data/img-cache/
data/pkm-cache/
# Scryfall's set list, same deal as data/pkm-cache/ (lib/mtg-sets-cache.mjs).
data/mtg-cache/
# One file per set, written once and kept — lib/*-cards-cache.mjs over lib/set-cache.mjs.
# Refetchable, so not source.
data/pkm-cards/
data/lorcana-cards/
# Lorcast's set list, same deal as data/mtg-cache/ (lib/lorcana-sets-cache.mjs).
data/lorcana-cache/
data/swu-cards/
data/mtg-cards/
data/onepiece-cards/

# Rotated SQLite snapshots written by lib/backup.mjs (VACUUM INTO tracker.db/repricer.db + a
# config bundle). Local disaster-recovery copies, not source — and they may contain data/.env if
# include_secrets is enabled, so they must NEVER be committed.
data/backups/

# Baked data catalogs (build artifacts, NOT source): regenerated in place on a timer by
# lib/refresh.mjs from the tracked seeds + live upstreams (TCGdex / Riot). Tracking them made
# every deploy collide with the server's own rebuild. Seeds stay tracked as the source of truth
# (data/pokemon-intl-seed.json); regenerate the bakes with
#   node scripts/build-pokemon-intl-sets.mjs   &&   node scripts/build-riftbound-data.mjs
# (or just let the 60s boot refresh repopulate them). funko_pop.json / pokemon-dex-en.json stay
# tracked — their upstreams are frozen / built by hand, so they don't churn.
data/pokemon-intl-sets.json
data/riftbound.json
# Riftbound market prices (regenerated by the 'riftbound-prices' bake from TCGplayer's public search
# API — the keyless replacement for the lapsed Scrydex price lane). Prices churn daily, so tracking
# this would collide with every rebuild. NO seed: a missing index just means "no price yet"
# (/api/riftbound/prices answers 503 and the collector records rb_index_missing), and the boot
# refresh repopulates it. Regenerate by hand with
#   node scripts/build-riftbound-prices.mjs
data/riftbound-prices.json
# EN early/pre-release set bake (regenerated by the pokemon-en-early bake from the tracked seed
# data/pokemon-en-early-seed.json + PriceCharting). Same rationale — a tracked bake collides with the
# server's own rebuild. Re-seeded from the seed on boot (lib/refresh.mjs ensureEnEarlySeeded).
data/pokemon-en-early.json

# Mega Evolution Promo roster (regenerated by the pokemon-mep bake from TCGplayer's search API +
# the Scrydex image CDN). Same rationale — a tracked bake collides with the server's own rebuild.
# Re-seeded from data/pokemon-mep-seed.json on boot (lib/refresh.mjs ensureMepSeeded).
data/pokemon-mep.json
# Set symbol/logo URL index for the listing-image rail badge, baked from Bulbapedia by
# scripts/build-pokemon-set-symbols.mjs (registered as the 'pokemon-set-symbols' refresh bake).
# URLs only — the images are fetched lazily through data/img-cache/. A host without it degrades to
# a number-only badge, so run the bake once on a fresh checkout.
data/pokemon-set-symbols.json
# Per-game set-art indexes for the rails (scripts/build-{mtg-set-logos,lorcana-set-art,
# swu-set-art,onepiece-set-art}.mjs; '<game>-set-art' refresh bakes). Same deal: URLs + printed
# totals only, absence degrades to the game-logo fallback, run the bakes once on a fresh checkout.
data/mtg-set-art.json
data/lorcana-set-art.json
data/swu-set-art.json
data/onepiece-set-art.json
# Clean One Piece art map (scripts/build-onepiece-tcgimages.mjs; 'onepiece-tcg-images' bake) —
# card code → TCGplayer productId per printing. Absent = listings keep the watermarked optcgapi art.
data/onepiece-tcg-images.json

# Runtime-editable config the settings dashboard writes at runtime — SERVER-OWNED so its live edits
# never collide with git pulls (tracking it did: it had to be skip-worktree'd on the server, which
# then blocked every pull). data/refresh.config.example.json is the tracked template; a missing file
# falls back to DEFAULT_CONFIG and is re-seeded from the example on boot (lib/refresh.mjs).
data/refresh.config.json
# Post-sale automation runtime config — SERVER-OWNED (settings dashboard writes it). Re-seeded from
# the tracked data/postsale.config.example.json on boot (lib/postsale.mjs ensureConfigSeeded).
data/postsale.config.json
# Repricer runtime config — SERVER-OWNED for the same reason. It was tracked until Phase 3, which
# meant every settings save on the always-on box dirtied `git status` on a file a pull wants to
# overwrite: exactly what forced skip-worktree onto refresh.config.json and then blocked pulls.
# Re-seeded + key-backfilled from data/repricer.config.example.json (lib/repricer.mjs).
data/repricer.config.json
# eBay listing config — SERVER-OWNED. Holds the account's stable business-policy IDs + merchant
# location (filled by POST /api/listings/account/bootstrap) + listing defaults; re-seeded from the
# tracked data/ebay-listing.config.example.json on boot (lib/listings.mjs ensureConfigSeeded).
data/ebay-listing.config.json
# Listing image compositor — SERVER-OWNED (settings dashboard writes it). Re-seeded from the tracked
# data/listing-image.config.example.json on boot (lib/listing-image-config.mjs ensureConfigSeeded).
data/listing-image.config.json
# Composed listing images, content-addressed by the compose hash. Pure derived output: every file is
# reproducible from its source image plus the layout config, exactly like data/img-cache/.
data/composed/
# The ORIGINAL bytes of owner-shot photos, kept so an ASSET_VERSION bump can re-brand them. Unlike
# everything else under data/, these are NOT regenerable — the only other copy is on the owner's
# phone — so they are excluded from git for size, not because they are disposable. Worth folding
# into data/backup.config.json if the photo library grows.
data/photo-originals/
data/listing-images/
